---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'About',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="About" title="Mind over Machine" subtitle="The Foundation for Regenerative Software Development" />

  <Features
    title="Mission"
    columns={1}
    items={[
      {
        title: 'A commercial non-profit foundation',
        description:
          'Our mission is to explore and share regenerative approaches to software development that create a net positive long-term value for people and the planet.',
      },
    ]}
  />

  <Features
    title="Three Pillars"
    columns={3}
    items={[
      {
        title: 'Think Tank',
        description:
          'Research, analysis and dissemination of long-term systems thinking and regenerative principles within disciplines related to or derived from software and software development',
      },
      {
        title: 'Laboratory',
        description: 'Development of software, tools and methods that demonstrate regenerative principles in practice.',
      },
      {
        title: 'Community of Practice',
        description:
          'Facilitation of a community of practice for practitioners, researchers, students and decision-makers with the aim of promoting regenerative software, software development and socio-technological understanding.',
      },
    ]}
  />

  <Features
    id="community-of-practice"
    title="Community of Practice"
    columns={1}
    items={[
      {
        title: 'Learning a craft by being close to people who practise it',
        description:
          'We build on the work of Lave and Wenger: you learn a craft by being close to the people who practise it. They call the way newcomers begin <em>legitimate peripheral participation</em>. Hanging around at the edge is a legitimate way to be here.',
      },
    ]}
  />
  <Features
    columns={3}
    items={[
      {
        title: "You don't have to be a developer",
        description: 'Writers, facilitators, organisers and reviewers are welcome.',
      },
      { title: "You don't have to commit to anything", description: 'Come when you can, leave when you need to.' },
      { title: 'Everything is open', description: 'Discussions, documents and code are public by default.' },
    ]}
  />

  <Features
    id="why-matrix"
    title="Why Matrix?"
    columns={1}
    items={[
      {
        title: 'We keep our own community on open infrastructure',
        description: `A foundation that argues for open, European, community-owned infrastructure should keep its own community on it. That is why we talk on Matrix, and why we are building <a class="underline" href="${getPermalink('/projects/civic/')}">Civic</a>, MoM's communication platform, on Matrix. Read <a class="underline" href="${getPermalink('/writings/new-to-matrix/#why-is-this-good')}">why Matrix is a good choice</a>.`,
      },
    ]}
  />

  <CallToAction
    actions={[{ variant: 'primary', text: 'Get involved', href: getPermalink('/get-involved/') }]}
    title="Want to be part of it?"
    subtitle="Start by showing up."
  />
</Layout>
