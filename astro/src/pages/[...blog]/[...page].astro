---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import Gallery from '~/components/blog/Gallery.astro';
import Headline from '~/components/blog/Headline.astro';

import { blogListRobots, fetchPosts, isBlogEnabled, isBlogListRouteEnabled } from '~/utils/blog';
import { BLOG_BASE, getPermalink } from '~/utils/permalinks';

export const prerender = true;

export const getStaticPaths = (async () => {
  if (!isBlogEnabled || !isBlogListRouteEnabled) return [];
  return [
    {
      params: { blog: BLOG_BASE || undefined, page: undefined },
      props: { posts: await fetchPosts({ locale: 'en', fallbackLocale: 'da' }) },
    },
  ];
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { posts } = Astro.props as Props;
const metadata = {
  title: 'Blog',
  robots: {
    index: blogListRobots?.index,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'Essays',
  },
};
---

<Layout metadata={metadata}>
  <section class="px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-6xl">
    <Headline>Writings</Headline>
    <p class="text-center text-lg text-muted dark:text-slate-400">
      All our writings listed chronologically. Browse <a class="underline" href={getPermalink('briefs', 'category')}
        >briefs</a
      >
      or <a class="underline" href={getPermalink('essays', 'category')}>essays</a>.
    </p>
    <Gallery {posts} />
  </section>
</Layout>
