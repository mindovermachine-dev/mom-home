---
import Image from '~/components/common/Image.astro';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import { fetchEvents, getOccurrenceTimestampOrInfinity } from '~/utils/events';
import { getPermalink } from '~/utils/permalinks';

const events = await fetchEvents({ locale: 'en' });
const now = Date.now();

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'medium',
  timeZone: 'UTC',
});

const isValidDate = (value: Date | string): value is Date => value instanceof Date && !Number.isNaN(value.getTime());
const isUpcomingOccurrence = (occurrence: { date: Date | string; time?: string }) =>
  isValidDate(occurrence.date) ? getOccurrenceTimestampOrInfinity(occurrence) >= now : true;
const isPastOccurrence = (occurrence: { date: Date | string; time?: string }) =>
  isValidDate(occurrence.date) ? getOccurrenceTimestampOrInfinity(occurrence) < now : false;
const occurrenceSortValue = (occurrence: { date: Date | string; time?: string }) =>
  getOccurrenceTimestampOrInfinity(occurrence);
const formatOccurrenceDate = (occurrence: { date: Date | string; time?: string }) => {
  const dateLabel = isValidDate(occurrence.date) ? dateFormatter.format(occurrence.date) : occurrence.date;
  return occurrence.time ? `${dateLabel} ${occurrence.time}` : dateLabel;
};

const splitEvents = events.map((event) => {
  const upcomingDates = event.dates
    .filter(isUpcomingOccurrence)
    .sort((a, b) => occurrenceSortValue(a) - occurrenceSortValue(b));
  const pastDates = event.dates
    .filter(isPastOccurrence)
    .sort((a, b) => occurrenceSortValue(a) - occurrenceSortValue(b));

  return {
    event,
    upcomingDates,
    pastDates,
  };
});

const upcomingEvents = splitEvents
  .filter((entry) => entry.upcomingDates.length > 0)
  .sort((a, b) => occurrenceSortValue(a.upcomingDates[0]) - occurrenceSortValue(b.upcomingDates[0]));

const pastEvents = splitEvents
  .filter((entry) => entry.pastDates.length > 0)
  .sort(
    (a, b) =>
      occurrenceSortValue(b.pastDates[b.pastDates.length - 1]) -
      occurrenceSortValue(a.pastDates[a.pastDates.length - 1])
  );

const metadata = {
  title: 'Events',
};

// Import the client-side event filter component
import EventClientFilter from '~/components/EventClientFilter.astro';
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Events"
    title="Events and community activities"
    subtitle="Upcoming and past events from the Mind over Machine community."
  />

  <section class="px-6 sm:px-6 pb-12 sm:pb-16 lg:pb-20 mx-auto max-w-5xl">
    <h2 class="text-2xl md:text-3xl font-bold font-heading">Upcoming Events</h2>
    {
      upcomingEvents.length > 0 ? (
        <ul id="events-upcoming-list" class="mt-6 grid gap-6">
          {upcomingEvents.map(({ event, upcomingDates }) => (
            <li data-first-date-timestamp={upcomingDates[0] ? getOccurrenceTimestampOrInfinity(upcomingDates[0]) : 0}>
              <a
                class="group flex flex-col gap-6 sm:flex-row sm:items-center"
                href={getPermalink(`events/${event.slug}`)}
              >
                {event.image && (
                  <div class="flex aspect-[600/338] shrink-0 items-center justify-center sm:h-[162px] sm:w-72 sm:aspect-auto">
                    <Image
                      src={event.image}
                      alt={`${event.title} event image`}
                      width={600}
                      height={338}
                      fit="contain"
                      layout="cover"
                      class="max-h-full max-w-full"
                    />
                  </div>
                )}
                <div class="rounded-xl border border-gray-200 bg-white p-5 transition group-hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-900 dark:group-hover:bg-slate-800 sm:flex-1">
                  <h3 class="text-xl font-bold font-heading">{event.title}</h3>
                  <div class="mt-2 text-sm text-muted dark:text-slate-400">
                    {upcomingDates.length === 1 ? (
                      <p>
                        {formatOccurrenceDate(upcomingDates[0])}
                        {upcomingDates[0].duration ? ` (${upcomingDates[0].duration})` : ''}
                      </p>
                    ) : (
                      <ul class="space-y-1">
                        {upcomingDates.map((occurrence) => (
                          <li>
                            {formatOccurrenceDate(occurrence)}
                            {occurrence.duration ? ` (${occurrence.duration})` : ''}
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                  <p class="mt-1 text-sm text-muted dark:text-slate-400">
                    {typeof event.location === 'string'
                      ? event.location
                      : [event.location.venue, event.location.address].filter(Boolean).join(', ')}
                  </p>
                  {event.excerpt && <p class="mt-3 text-muted dark:text-slate-300">{event.excerpt}</p>}
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p id="events-upcoming-empty" class="mt-6 text-muted dark:text-slate-400">
          No upcoming events right now.
        </p>
      )
    }

    {
      pastEvents.length > 0 && (
        <details class="mt-10 group">
          <summary class="inline-flex cursor-pointer list-none items-center rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium hover:bg-gray-50 dark:border-slate-600 dark:hover:bg-slate-800">
            <span class="group-open:hidden">See Past Events</span>
            <span class="hidden group-open:inline">Hide Past Events</span>
          </summary>

          <section class="mt-6">
            <h2 class="text-2xl md:text-3xl font-bold font-heading">Past Events</h2>
            <ul id="events-past-list" class="mt-6 grid gap-6">
              {pastEvents.map(({ event, pastDates }) => (
                <li data-first-date-timestamp={pastDates[0] ? getOccurrenceTimestampOrInfinity(pastDates[0]) : 0}>
                  <a
                    class="group flex flex-col gap-6 sm:flex-row sm:items-center"
                    href={getPermalink(`events/${event.slug}`)}
                  >
                    {event.image && (
                      <div class="flex aspect-[600/338] shrink-0 items-center justify-center sm:h-[162px] sm:w-72 sm:aspect-auto">
                        <Image
                          src={event.image}
                          alt={`${event.title} event image`}
                          width={600}
                          height={338}
                          fit="contain"
                          layout="cover"
                          class="max-h-full max-w-full"
                        />
                      </div>
                    )}
                    <div class="rounded-xl border border-gray-200 bg-white p-5 transition group-hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-900 dark:group-hover:bg-slate-800 sm:flex-1">
                      <h3 class="text-xl font-bold font-heading">{event.title}</h3>
                      <div class="mt-2 text-sm text-muted dark:text-slate-400">
                        {pastDates.length === 1 ? (
                          <p>
                            {formatOccurrenceDate(pastDates[0])}
                            {pastDates[0].duration ? ` (${pastDates[0].duration})` : ''}
                          </p>
                        ) : (
                          <ul class="space-y-1">
                            {pastDates.map((occurrence) => (
                              <li>
                                {formatOccurrenceDate(occurrence)}
                                {occurrence.duration ? ` (${occurrence.duration})` : ''}
                              </li>
                            ))}
                          </ul>
                        )}
                      </div>
                      <p class="mt-1 text-sm text-muted dark:text-slate-400">
                        {typeof event.location === 'string'
                          ? event.location
                          : [event.location.venue, event.location.address].filter(Boolean).join(', ')}
                      </p>
                      {event.excerpt && <p class="mt-3 text-muted dark:text-slate-300">{event.excerpt}</p>}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        </details>
      )
    }
  </section>

  <EventClientFilter />
</Layout>
