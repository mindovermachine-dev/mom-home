---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Services',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Services"
    title="A joined-up offer for a more regenerative software industry"
    subtitle="Alliance membership is the foundation for organizations. From there, they can access product stewardship, a sovereign development stack, learning and advisory, and hands-on delivery."
  />

  <section class="px-6 py-12 sm:py-16 mx-auto max-w-6xl">
    <ol class="grid gap-4 md:grid-cols-5" aria-label="Our service model">
      <li class="border-t-2 border-primary pt-4">
        <span class="text-sm font-semibold text-muted">01</span>
        <h2 class="mt-2 text-lg font-bold">Alliance membership</h2>
        <p class="mt-2 text-sm text-muted">Shared direction, community, visibility and member benefits.</p>
      </li>
      <li class="border-t-2 border-primary pt-4">
        <span class="text-sm font-semibold text-muted">02</span>
        <h2 class="mt-2 text-lg font-bold">Product stewardship</h2>
        <p class="mt-2 text-sm text-muted">Independent governance and standards for FOSS products.</p>
      </li>
      <li class="border-t-2 border-primary pt-4">
        <span class="text-sm font-semibold text-muted">03</span>
        <h2 class="mt-2 text-lg font-bold">Sovereign dev stack</h2>
        <p class="mt-2 text-sm text-muted">European-rooted FOSS infrastructure for software development.</p>
      </li>
      <li class="border-t-2 border-primary pt-4">
        <span class="text-sm font-semibold text-muted">04</span>
        <h2 class="mt-2 text-lg font-bold">Learning and advisory</h2>
        <p class="mt-2 text-sm text-muted">Courses, workshops, talks and strategic advice.</p>
      </li>
      <li class="border-t-2 border-primary pt-4">
        <span class="text-sm font-semibold text-muted">05</span>
        <h2 class="mt-2 text-lg font-bold">Delivery</h2>
        <p class="mt-2 text-sm text-muted">Prepaid hour bundles and ongoing capacity agreements.</p>
      </li>
    </ol>
  </section>

  <Features2
    title="Explore how we can help"
    subtitle="Choose the area that best fits your needs and follow the path to more detail."
    columns={2}
    items={[
      {
        title: 'MoM FOSS Alliance',
        description: 'Help shape the laboratory’s FOSS priorities and take part in the wider community.',
        callToAction: { variant: 'secondary', text: 'Explore Alliance membership', href: '/membership/' },
      },
      {
        title: 'Product stewardship',
        description: 'Build a durable governance, quality and community model around a FOSS product.',
        callToAction: { variant: 'secondary', text: 'Explore stewardship', href: '#stewardship' },
      },
      {
        title: 'MoM FOSS Dev Stack',
        description: 'Explore a European-rooted development environment built from FOSS tools.',
        callToAction: { variant: 'secondary', text: 'Explore the stack', href: '#dev-stack' },
      },
      {
        title: 'Learning and advisory',
        description:
          'Get strategic advice, talks and learning days on FOSS, digital sovereignty and software practice.',
        callToAction: { variant: 'secondary', text: 'Explore advisory', href: '#learning' },
      },
      {
        title: 'Courses and workshops',
        description:
          'Practical learning on digital agency, FOSS, AI, development practice and sovereign infrastructure.',
        callToAction: { variant: 'secondary', text: 'Browse courses', href: '/courses/' },
      },
      {
        title: 'Delivery and capacity',
        description: 'Turn plans into working software through prepaid hour bundles or ongoing capacity agreements.',
        callToAction: { variant: 'secondary', text: 'See capacity examples', href: '/membership/#capacity' },
      },
    ]}
  />

  <section class="px-6 py-10 sm:py-14 mx-auto max-w-6xl border-t border-gray-200 dark:border-slate-700" id="membership">
    <p class="text-sm font-semibold text-primary">01 / The foundation</p>
    <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-start">
      <div>
        <h2 class="mt-2 text-3xl font-bold font-heading">MoM FOSS Alliance</h2>
        <p class="mt-4 max-w-3xl text-muted dark:text-slate-300">
          Alliance membership is for organizations that want to support a more regenerative software industry and help
          set the direction for the laboratory’s FOSS work. Alliance membership income is earmarked for developing,
          facilitating and operating FOSS in the laboratory.
        </p>
      </div>
      <a class="btn-primary" href="/membership/">Alliance membership and fees</a>
    </div>
    <ul class="mt-6 grid gap-3 text-muted sm:grid-cols-2">
      <li>Quarterly MoM-FOSS Alliance sessions</li>
      <li>A member profile and logo on the website, with visibility in public communications</li>
      <li>Participation in the Community of Practice and the option to host events</li>
      <li>Alliance members receive 40% off all tickets to the annual MoM conference</li>
      <li>Post project opportunities and open roles on the member platform</li>
      <li>Substantial member discounts on prepaid hour bundles and ongoing capacity agreements</li>
    </ul>
  </section>

  <section
    class="px-6 py-10 sm:py-14 mx-auto max-w-6xl border-t border-gray-200 dark:border-slate-700"
    id="stewardship"
  >
    <p class="text-sm font-semibold text-primary">02 / Standards and governance</p>
    <h2 class="mt-2 text-3xl font-bold font-heading">Product stewardship</h2>
    <p class="mt-4 max-w-3xl text-muted dark:text-slate-300">
      We provide an independent stewardship home for FOSS products, with clear standards, traceability and a durable
      operating model. Under the Basis Stewardship offer, the organization that initiated the product provides a Tech
      Lead and development team for ongoing coding.
    </p>
    <ul class="mt-5 grid gap-3 text-muted sm:grid-cols-2">
      <li>Dev Containers, agent-ready workflows, Detroit School testing, SemVer and trunk-based development</li>
      <li>Weekly MoM Tech Talks and ongoing dialogue with the product team</li>
      <li>Open issue and discussion workflows that make community contributions possible</li>
      <li>Maintainer or Driver capacity can be added when the team needs hands-on support</li>
    </ul>
    <p class="mt-5 font-semibold">Basis Stewardship: DKK 10,000 per product per year. Alliance membership required.</p>
  </section>

  <section class="px-6 py-10 sm:py-14 mx-auto max-w-6xl border-t border-gray-200 dark:border-slate-700" id="dev-stack">
    <p class="text-sm font-semibold text-primary">03 / Digital sovereignty</p>
    <h2 class="mt-2 text-3xl font-bold font-heading">MoM FOSS Dev Stack</h2>
    <p class="mt-4 max-w-3xl text-muted dark:text-slate-300">
      A development stack built entirely from modern FOSS tools, with a European foundation and a focus on digital
      sovereignty and data independence. Use it as the platform for a stewarded product or as a private stack for your
      organization.
    </p>
    <div class="mt-6 grid gap-8 md:grid-cols-2">
      <div>
        <h3 class="text-xl font-bold">FOSS Product Stack</h3>
        <p class="mt-2 text-muted dark:text-slate-300">
          A dedicated development environment for a product under MoM Stewardship. It can include Forgejo for code,
          CI/CD and issue tracking, Matrix for communication, and locally run open-source language models.
        </p>
        <p class="mt-3 font-semibold">DKK 10,000 per product per year. Compute and GPU usage are billed separately.</p>
      </div>
      <div>
        <h3 class="text-xl font-bold">Private Enterprise Stack</h3>
        <p class="mt-2 text-muted dark:text-slate-300">
          A standalone, isolated stack for your organization’s internal development. Pricing is fixed regardless of the
          number of developers and includes a basic SLA for server operations, infrastructure monitoring and critical
          security updates.
        </p>
        <p class="mt-3 font-semibold">DKK 35,000–60,000 per year, depending on size; raw server hosting excluded.</p>
      </div>
    </div>
  </section>

  <section class="px-6 py-10 sm:py-14 mx-auto max-w-6xl border-t border-gray-200 dark:border-slate-700" id="learning">
    <p class="text-sm font-semibold text-primary">04 / Skills and perspective</p>
    <h2 class="mt-2 text-3xl font-bold font-heading">Learning, courses and trusted advisory</h2>
    <p class="mt-4 max-w-3xl text-muted dark:text-slate-300">
      We help leaders, organizations and developers navigate FOSS, digital sovereignty and regenerative software
      practice.
    </p>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      <div>
        <h3 class="text-lg font-bold">Advisory</h3>
        <p class="mt-2 text-muted dark:text-slate-300">
          FOSS strategy and governance, sovereign infrastructure, and regenerative architecture and workflows.
        </p>
      </div>
      <div>
        <h3 class="text-lg font-bold">Talks and learning days</h3>
        <p class="mt-2 text-muted dark:text-slate-300">
          Tailored keynotes and learning days on the future of software development and socio-technical balance.
        </p>
      </div>
      <div>
        <h3 class="text-lg font-bold">Courses and workshops</h3>
        <p class="mt-2 text-muted dark:text-slate-300">
          Digital agency, the FOSS ecosystem, AI and LLMs, trunk-based development with collaborative agents, and the
          MoM FOSS Dev Stack in practice.
        </p>
        <a class="mt-3 inline-flex font-semibold hover:underline" href="/courses/">
          Browse courses and workshops <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <p class="mt-5 text-sm text-muted dark:text-slate-300">
      Advisory, learning days and workshops are available at member rates or through prepaid hour bundles.
    </p>
  </section>

  <section class="px-6 py-10 sm:py-14 mx-auto max-w-6xl border-t border-gray-200 dark:border-slate-700" id="capacity">
    <p class="text-sm font-semibold text-primary">05 / From plans to practice</p>
    <h2 class="mt-2 text-3xl font-bold font-heading">Delivery and ongoing capacity</h2>
    <p class="mt-4 max-w-3xl text-muted dark:text-slate-300">
      We can help with advisory, architecture, workshops, value stream mapping and hands-on work on FOSS products.
      Alliance members receive substantial discounts when purchasing capacity in volume, through prepaid hour bundles or
      ongoing agreements for a set amount of monthly capacity.
    </p>
    <a class="btn-secondary mt-6 inline-flex" href="/membership/#capacity">See example capacity agreements</a>
  </section>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Start a conversation',
        href: '/contact',
      },
    ]}
    title="Looking for practical support?"
    subtitle="Tell us what you are working on and what you would like to improve."
  />
</Layout>
