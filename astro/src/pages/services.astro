---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { fetchServices } from '~/utils/services';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Services',
};

const services = await fetchServices();
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Services"
    title="Think tank and Laboratory services for regenerative software"
    subtitle="Advice, inspiration and hands-on support for teams that want better software outcomes over the long run."
  />

  <Features2
    title="How we can help"
    columns={2}
    items={services.map((service) => ({
      title: service.title,
      description: service.excerpt,
      callToAction: {
        variant: 'link',
        text: 'Read more',
        href: getPermalink(`services/${service.slug}`),
      },
    }))}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Start a conversation',
        href: '/contact',
      },
    ]}
    title="Need practical support?"
    subtitle="Tell us where you are and what you are trying to improve."
  />
</Layout>
