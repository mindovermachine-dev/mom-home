---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import { fetchCourses } from '~/utils/courses';
import { getCanonical, getPermalink } from '~/utils/permalinks';

const entries = await fetchCourses('en');
const courses = entries
  .map((course) => ({ ...course, slug: course.id.slice('en/'.length) }))
  .sort((a, b) => a.data.order - b.data.order);

const metadata = {
  title: 'Courses and workshops',
  description:
    'Practical courses and workshops on digital agency, FOSS, AI, software development and digital sovereignty.',
  canonical: String(getCanonical(getPermalink('courses'))),
  openGraph: {
    images: [{ url: '~/assets/images/courses/course-og-default-en.png' }],
  },
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Courses and workshops"
    title="Learn by doing"
    subtitle="Practical learning on FOSS, digital agency and modern software development, shaped around your people and goals."
  />

  <section class="px-6 py-12 sm:py-16 mx-auto max-w-6xl" aria-labelledby="course-list-heading">
    <h2 id="course-list-heading" class="sr-only">Our courses</h2>
    <ul class="grid gap-5 md:grid-cols-2">
      {
        courses.map((course) => (
          <li>
            <article class="flex h-full flex-col border-t-2 border-primary bg-white p-6 dark:bg-slate-900">
              <div
                class="mb-5 flex h-11 w-11 items-center justify-center rounded-lg border border-gray-200 text-primary dark:border-slate-700"
                aria-hidden="true"
              >
                <Icon name={course.data.icon} class="h-6 w-6" />
              </div>
              <h2 class="text-xl font-bold font-heading">{course.data.title}</h2>
              <p class="mt-3 text-muted dark:text-slate-300">{course.data.excerpt}</p>
              <dl class="mt-5 grid gap-3 text-sm sm:grid-cols-2">
                <div>
                  <dt class="font-semibold">For</dt>
                  <dd class="mt-1 text-muted dark:text-slate-300">{course.data.audience}</dd>
                </div>
                <div>
                  <dt class="font-semibold">Format</dt>
                  <dd class="mt-1 text-muted dark:text-slate-300">{course.data.format}</dd>
                </div>
              </dl>
              <a class="btn-secondary mt-6 self-start" href={getPermalink(`courses/${course.slug}`)}>
                Explore the course
              </a>
            </article>
          </li>
        ))
      }
    </ul>
    <p class="mt-8 max-w-3xl text-sm text-muted dark:text-slate-300">
      Courses can be booked at member rates or through prepaid hour bundles. We can tailor the content, format and scope
      to your needs.
    </p>
  </section>
</Layout>
