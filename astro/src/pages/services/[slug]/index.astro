---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { fetchServices } from '~/utils/services';
import { getCanonical, getPermalink } from '~/utils/permalinks';

export const prerender = true;

export const getStaticPaths = (async () => {
  const services = await fetchServices();

  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { service } = Astro.props as Props;

const metadata = {
  title: service.title,
  description: service.excerpt,
  canonical: String(getCanonical(getPermalink(`services/${service.slug}`))),
};
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <a class="inline-flex text-sm hover:underline" href={getPermalink('services')}>← Back to Services</a>

    <header class="mt-4">
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">{service.title}</h1>
      {service.excerpt && <p class="mt-4 text-lg text-muted dark:text-slate-400">{service.excerpt}</p>}
    </header>

    {
      service.Content && (
        <div class="mt-10 prose prose-md lg:prose-xl dark:prose-invert">
          <service.Content />
        </div>
      )
    }

    <div class="mt-14 border-t border-gray-200 dark:border-slate-700 pt-8">
      <CallToAction
        actions={[
          {
            variant: 'primary',
            text: 'Start a conversation',
            href: '/contact',
          },
        ]}
        title="Want help with this area?"
        subtitle="Tell us your context and constraints."
      />
    </div>
  </section>
</Layout>
