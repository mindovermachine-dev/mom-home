---
import type { GetStaticPaths } from 'astro';

import EventDetailPage from '~/components/content/EventDetailPage.astro';
import { fetchEvents, findLocalizedEventWithFallback } from '~/utils/events';
import { getCanonical, getPermalink } from '~/utils/permalinks';

export const prerender = true;

export const getStaticPaths = (async () => {
  const events = await fetchEvents({ locale: 'da', fallbackLocale: 'en' });

  return events.map((event) => ({
    params: { slug: event.slug },
  }));
}) satisfies GetStaticPaths;

const slug = Astro.params.slug ?? '';
const { event, usedLocale } = await findLocalizedEventWithFallback({ slug, locale: 'da', fallbackLocale: 'en' });

if (!event) {
  return Astro.redirect('/da/events/');
}

const metadata = {
  title: event.title,
  description: event.excerpt,
  canonical: String(getCanonical(getPermalink(`da/events/${event.slug}`))),
  openGraph: event.image
    ? {
        images: [
          {
            url: typeof event.image === 'string' ? event.image : event.image.src,
          },
        ],
      }
    : undefined,
};
---

<EventDetailPage
  event={event}
  metadata={metadata}
  backHref={getPermalink('da/events')}
  backLabel="← Back to Events"
  localeFallback={usedLocale === 'en' ? 'da' : undefined}
  locale="da"
/>
