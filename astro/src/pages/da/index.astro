---
import Layout from '~/layouts/PageLayout.astro';
import Logo from '~/components/Logo.astro';
import Image from '~/components/common/Image.astro';
import HeroX from '~/components/widgets/HeroX.astro';
import Features from '~/components/widgets/Features.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Mind over Machine',
  ignoreTitleTemplate: true,
  description: 'En fond for regenerativ softwareudvikling gennem essays, events og services.',
};
---

<Layout metadata={metadata}>
  <div class="flex justify-center pt-6 md:pt-10">
    <Logo class="h-20 w-auto md:h-28" width={560} />
  </div>

  <HeroX
    actions={[
      {
        variant: 'primary',
        text: 'Skriverier',
        href: '/da/writings/',
      },
      {
        text: 'Tjenester',
        href: '/da/services/',
      },
    ]}
    overlayActions={[
      {
        variant: 'primary',
        text: 'Tilmeld dig kommende gratis CRA-events',
        href: '/da/events/',
        position: 'left',
        icon: 'tabler:calendar-event',
      },
    ]}
    tagline="Softwaresystemer i balance — som ikke løber løbsk"
    imageCaption="MoM arrangerer en serie af tre gratis events om EU's Cyber Resilience Act (CRA), dens betydning for softwareproducenter, dens indvirkning på Free and Open Source Software (FOSS) og en enkel måde at håndtere CRA-compliance gennem et simpelt FOSS-værktøj udviklet af MoM-fællesskabet."
  >
    <Fragment slot="title">
      Mind over Machine
      <span class="text-accent dark:text-white">Regenerativ software i praksis</span>
    </Fragment>

    <Fragment slot="subtitle">
      Vi er en non-profit fond, der samler en <b>tænketank</b>, et <b>laboratorium</b> og et <b>praksisfællesskab</b>.
      Vores mission er at udforske og dele regenerative tilgange og principper for softwareudvikling, som skaber en
      langsigtet, balanceret værdi for mennesker, samfund og verden. Vi tror på, at software kan være en kraft for det
      gode, når det udvikles og anvendes med omtanke og systemisk forståelse.
    </Fragment>
    <Fragment slot="image">
      <Image src="~/assets/images/events/mom-cra.png" alt="Mind over Machine visual" />
    </Fragment>
  </HeroX>
  <Features
    id="focus"
    tagline="Hvad vi laver"
    title="Tre søjler i vores arbejde"
    items={[
      {
        title: 'Tænketank:',
        subtitle: 'Nytænkning og formidling',
        description:
          'Vi udvikler, analyserer, forsker og publicerer gratis materiale om regenerative softwareudvikling, systemtænkning, etik og langsigtede balancerede praksisser.',
        icon: 'tabler:book',
        callToAction: {
          text: 'Udforsk vores essays og skriverier',
          href: '/da/writings/',
        },
      },
      {
        title: 'Praksisfællesskab:',
        subtitle: 'Legitim perifær deltagelse',
        description:
          'Vi arrangerer events og samtaler, hvor praktikere tester idéer, deler lærdomme og formerer en bedre softwarekultur.',
        icon: 'tabler:users-group',
        callToAction: {
          text: 'Udforsk aktiviteter',
          href: '/da/events/',
        },
      },
      {
        title: 'Laboratorium:',
        subtitle: 'Eksperimenter og medlemsengagement',
        description:
          'Vi tester antagelser og hypoteser om regenerative principper i samarbejde med medlemmer og akademia.',
        icon: 'tabler:flask',
        callToAction: {
          text: 'Udforsk laboratoriumstjenester',
          href: '/da/services/',
        },
      },
    ]}
  />

  <BlogLatestPosts
    title="Seneste skriverier"
    information="Nyeste skriverier fra Mind over Machine"
    linkText="Se alle skriverier"
    linkUrl="/da/writings/"
    locale="da"
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Kontakt os',
        href: '/da/contact/',
      },
    ]}
    title="Søger I en regenerativ vej for jeres softwareorganisation?"
    subtitle="Lad os udforske den sammen."
  />
</Layout>
