---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Om Os',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Om Os" title="Mind over Machine" subtitle="Fonden for Regenerativ Softwareudvikling" />

  <Features
    title="Mission"
    columns={1}
    items={[
      {
        title: 'En almennyttig erhvervsdrivende fond',
        description:
          'Vores overordnede formål er at afsøge, udforske, udvikle og udbrede tanker, principper, værktøjer og praksis for, hvordan software og softwareudvikling kan udføres således at det bidrager til et regenerativt paradigme, der skaber en balanceret systemisk værdi for mennesker, samfund og verden. Fonden opererer inden for en socio-teknologisk diskurs med fokus på det etiske og filosofiske møde mellem menneske og maskine samt på kvalitet i både softwareprodukter og -processer.',
      },
    ]}
  />
  <Features
    title="Tre Søjler"
    columns={3}
    items={[
      {
        title: 'Tænketank',
        description:
          'Forskning, analyse og formidling af langsigtet systemtænkning og regenerative principper inden for discipliner relateret til eller afledt af software og softwareudvikling',
      },
      {
        title: 'Laboratorium',
        description: 'Udvikling af software, værktøjer og metoder der demonstrerer regenerative principper i praksis.',
      },
      {
        title: 'Praksisfællesskab',
        description:
          'Facilitering af et praksisfællesskab <em>(Community of Practice)</em> for praktikere, forskere, studerende og beslutningstagere med henblik på at fremme regenerativ software, softwareudvikling og teknologiforståelse.',
      },
    ]}
  />

  <Features
    id="community-of-practice"
    title="Praksisfællesskab"
    columns={1}
    items={[
      {
        title: 'At lære et håndværk ved at være tæt på dem, der udøver det',
        description:
          'Vi bygger på Lave og Wengers arbejde: man lærer et håndværk ved at være tæt på de mennesker, der udøver det. De kalder måden, nytilkomne begynder på, <em>legitim perifær deltagelse</em> (<em>legitimate peripheral participation</em>). At hænge ud i udkanten er en legitim måde at være her på.',
      },
    ]}
  />
  <Features
    columns={3}
    items={[
      {
        title: 'Du behøver ikke være udvikler',
        description: 'Skribenter, facilitatorer, organisatorer og reviewere er velkomne.',
      },
      { title: 'Du behøver ikke binde dig til noget', description: 'Kom når du kan, gå når du skal.' },
      { title: 'Alt er åbent', description: 'Diskussioner, dokumenter og kode er offentlige som udgangspunkt.' },
    ]}
  />

  <Features
    id="why-matrix"
    title="Hvorfor Matrix?"
    columns={1}
    items={[
      {
        title: 'Vi holder vores eget fællesskab på åben infrastruktur',
        description: `En fond, der argumenterer for åben, europæisk og fællesskabsejet infrastruktur, bør have sit eget fællesskab på den. Derfor snakker vi sammen på Matrix, og derfor bygger vi <a class="underline" href="${getPermalink('/da/projects/civic/')}">Civic</a>, MoMs kommunikationsplatform, på Matrix. Læs <a class="underline" href="${getPermalink('/da/writings/new-to-matrix/#why-is-this-good')}">hvorfor Matrix er et godt valg</a> (på engelsk).`,
      },
    ]}
  />

  <CallToAction
    actions={[{ variant: 'primary', text: 'Kom med', href: getPermalink('/da/get-involved/') }]}
    title="Lyst til at være med?"
    subtitle="Start med at dukke op."
  />
</Layout>
