---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Kom med',
  description:
    'Start med at dukke op. Din første uge hos Mind over Machine, fire veje ind og hvordan man vokser i vores fællesskab.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Kom med"
    title="Start med at dukke op"
    subtitle="Hver tirsdag morgen mødes vi online til Office Hours. Ingen tilmelding, ingen forberedelse. Kom bare."
    callToAction={{ text: 'Om Office Hours', href: getPermalink('/da/events/mom-officehours/') }}
  />

  <Steps
    id="first-week"
    tagline="Din første uge"
    title="Fire små trin, cirka en time i alt"
    subtitle="Du behøver ikke være udvikler. Skribenter, facilitatorer, organisatorer, reviewere og tolke mellem tech og resten af verden er alle velkomne."
    items={[
      {
        title: 'Trin 1: <span class="font-medium">Kom på Matrix</span>',
        description: `Matrix er der, hvor vores fællesskab snakker sammen. Opret en konto, hvis du ikke har en, og tilslut dig vores space <code>#mindovermachine:matrix.org</code>. Er du i tvivl om hvorfor Matrix? Læs <a class="underline" href="${getPermalink('/da/writings/new-to-matrix/#why-is-this-good')}">hvorfor vi bruger det</a> (på engelsk).`,
        callToAction: {
          text: 'Ny på Matrix?',
          href: getPermalink('/da/writings/new-to-matrix/'),
        },
        icon: 'tabler:message-circle',
      },
      {
        title: 'Trin 2: <span class="font-medium">Sig hej i General-rummet</span>',
        description: `Kopiér dette, udfyld felterne og send det:
<blockquote class="mt-3 border-l-4 border-gray-400 pl-4 italic">Hej, jeg hedder [navn]. Jeg arbejder med [hvad du laver].<br />Jeg fandt MoM gennem [person/event/artikel].<br />Jeg er nysgerrig på [noget], og jeg kunne forestille mig at hjælpe med [noget, eller "ved ikke endnu"].</blockquote>`,
        callToAction: {
          text: 'Åbn space',
          href: 'https://matrix.to/#/#mindovermachine:matrix.org',
          target: '_blank',
        },
        icon: 'tabler:hand-stop',
      },
      {
        title: 'Trin 3: <span class="font-medium">Kom til Office Hours</span>',
        description:
          'Vi bruger Lean Coffee-formatet: en blank dagsorden, alle foreslår emner, vi stemmer, og hvert emne får otte minutter. Tid og sted står på begivenhedssiden.',
        callToAction: {
          text: 'Office Hours',
          href: getPermalink('/da/events/mom-officehours/'),
        },
        icon: 'tabler:coffee',
      },
      {
        title: 'Trin 4: <span class="font-medium">Læs to korte sider</span>',
        description: `Vores <a class="underline" href="https://docs.mindovermachine.dk/da/vision/manifesto/">manifest</a> og vores <a class="underline" href="https://docs.mindovermachine.dk/da/vision/crowd-values/">C.R.O.W.D.-værdier</a>. Hold øje med Dorith. Hun dukker op. Vil du også have nyt i din indbakke? Tilmeld dig <a class="underline" href="${getPermalink('/da/writings/dont-miss-a-beat/')}">opdateringsgruppen</a>.`,
        icon: 'tabler:book',
      },
    ]}
  />

  <Features
    id="ways-in"
    tagline="Fire veje ind"
    title="Vælg den dør, der passer dig"
    columns={2}
    items={[
      {
        title: 'Kom på Matrix',
        description: 'Vores community-chat. Den fører ind i fællesskabet.',
        icon: 'tabler:message-circle',
        callToAction: { text: 'Tilslut space', href: 'https://matrix.to/#/#mindovermachine:matrix.org' },
      },
      {
        title: 'Kom til huddle',
        description:
          'Office Hours er vores ugentlige åbne møde om tirsdagen. Den bedste vej ind og et godt sted at pitche idéer til tænketanken eller laboratoriet.',
        icon: 'tabler:coffee',
        callToAction: { text: 'Office Hours', href: getPermalink('/da/events/mom-officehours/') },
      },
      {
        title: 'Kom IRL',
        description: 'Mød os fysisk til et event. Det fører ind i tænketanken og fællesskabet.',
        icon: 'tabler:calendar-event',
        callToAction: { text: 'Se begivenheder', href: getPermalink('/da/events/') },
      },
      {
        title: 'Start med at hacke',
        description: 'Åben kode, idéer og diskussioner på GitHub. Det fører ind i laboratoriet.',
        icon: 'tabler:brand-github',
        callToAction: { text: 'Besøg GitHub', href: 'https://github.com/mindovermachine-dev' },
      },
    ]}
  />

  <Features2
    id="grow"
    tagline="Sådan vokser man her"
    title="Fire stadier, ingen niveauer"
    columns={4}
    items={[
      {
        title: 'Hæng ud',
        description:
          'Du læser med, kommer til Office Hours en gang imellem og lytter. Næste skridt: sig hej og stil ét spørgsmål.',
        icon: 'tabler:eye',
      },
      {
        title: 'Dukk op',
        description:
          'Du deltager i diskussioner, kommenterer idéer og kommer nogenlunde regelmæssigt. Næste skridt: tag et emne med til Office Hours.',
        icon: 'tabler:users',
      },
      {
        title: 'Hjælp til',
        description:
          'Du tager en lille, afgrænset opgave: gennemgå en tekst, test et værktøj, hjælp med at afvikle et event, skriv et brief, ret en fejl. Næste skridt: spørg "hvad kan jeg hjælpe med i denne uge?" på Matrix eller til Office Hours.',
        icon: 'tabler:hand-grab',
      },
      {
        title: 'Bær',
        description:
          'Du ejer noget over tid: et projekt, en eventserie, et stykke skrivning, en cirkel. Næste skridt: snak med os om at blive en del af Initiative Circle.',
        icon: 'tabler:flag',
      },
    ]}
  />
  <p class="max-w-3xl mx-auto px-6 pb-8 text-center text-muted">
    Der er ingen niveauer, badges eller adgangsprøver. Det er helt fint at gå tilbage til at hænge ud, og ingen vil bede
    dig forklare dig.
  </p>

  <Features2
    id="initiative-circle"
    tagline="Hvor bidrag fører hen"
    title="Initiative Circle"
    columns={1}
    items={[
      {
        title: 'Fællesskabets aktive kerne',
        description: `Initiative Circle er selvorganiserende og rådgivende og har reel indflydelse i fonden. Den høres før større ændringer i vedtægterne og kan indstille op til to bestyrelsesmedlemmer. Deltagelse er gratis og bygger på dokumenteret, frivillig aktivitet: at arrangere events eller meetups, redaktionelt arbejde, review, facilitering, open source-bidrag eller koordinering af fællesskabet. <a class="underline" href="https://docs.mindovermachine.dk/da/governance/initiative-circle/">Læs om hvordan Initiative Circle fungerer</a>.`,
        icon: 'tabler:circles',
      },
    ]}
  />

  <Features2
    id="where-things-live"
    tagline="Hvor tingene bor"
    title="Find rundt"
    columns={3}
    items={[
      {
        title: 'Docs',
        description: 'Vision, værdier og governance.',
        icon: 'tabler:books',
        callToAction: { text: 'Åbn docs', href: 'https://docs.mindovermachine.dk/da/' },
      },
      {
        title: 'Opdateringer',
        description: 'Events, essays og releases på mail.',
        icon: 'tabler:mail',
        callToAction: { text: 'Gå ikke glip af noget', href: getPermalink('/da/writings/dont-miss-a-beat/') },
      },
      {
        title: 'Email',
        description: 'Vil du hellere skrive til et menneske? Send os en besked.',
        icon: 'tabler:at',
        callToAction: { text: 'hey@mindovermachine.dk', href: 'mailto:hey@mindovermachine.dk' },
      },
    ]}
  />

  <Features2
    id="organisations"
    tagline="For organisationer"
    title="Vil I involvere jeres organisation?"
    columns={1}
    items={[
      {
        title: 'Se Medlemskab',
        description: `Organisationer kan støtte fonden gennem <a class="underline" href="${getPermalink('/da/membership/')}">Medlemskab</a>. I er også velkomne til at <a class="underline" href="${getPermalink('/da/contact/')}">tage kontakt</a>.`,
        icon: 'tabler:building',
      },
    ]}
  />

  <p class="max-w-3xl mx-auto px-6 pt-8 text-center text-xl">
    Hvis du er i tvivl om, hvorvidt du er "teknisk nok", "senior nok" eller "engageret nok" til at være her: det er du.
    Kom som du er, og se hvad der sker. Vi ses på tirsdag. 🌱
  </p>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Kom til Office Hours',
        href: getPermalink('/da/events/mom-officehours/'),
      },
    ]}
  />
</Layout>
