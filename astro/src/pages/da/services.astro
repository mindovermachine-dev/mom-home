---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { fetchServices } from '~/utils/services';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Tjenester',
};

const services = await fetchServices({ locale: 'da', fallbackLocale: 'en' });
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Tjenester"
    title="Tænketank og Laboratorium tjenester i regenerativ software"
    subtitle="Rådgivning, inspiration og praksis for teams, der vil have bedre softwareresultater på lang sigt."
  />

  <Features2
    title="Hvordan vi kan hjælpe"
    columns={2}
    items={services.map((service) => ({
      title: service.title,
      description: service.excerpt,
      callToAction: {
        variant: 'secondary',
        text: 'Læs mere',
        href: getPermalink(`da/services/${service.slug}`),
        class:
          '!mt-3 !inline-flex !rounded-md !px-3 !py-1.5 !text-sm !font-medium border border-gray-300 hover:!bg-gray-50 dark:border-slate-600 dark:hover:!bg-slate-800',
      },
    }))}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Tal med os',
        href: '/da/contact/',
      },
    ]}
    title="Har du brug for praktisk hjælp?"
    subtitle="Fortæl os hvor langt du er og hvad du forsøger at forbedre."
  />
</Layout>
