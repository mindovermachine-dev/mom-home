---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import Gallery from '~/components/blog/Gallery.astro';
import Headline from '~/components/blog/Headline.astro';

import { blogListRobots, fetchPosts, isBlogEnabled, isBlogListRouteEnabled } from '~/utils/blog';
import { BLOG_BASE, CATEGORY_BASE, getPermalink } from '~/utils/permalinks';

export const prerender = true;

export const getStaticPaths = (async () => {
  if (!isBlogEnabled || !isBlogListRouteEnabled) return [];
  return [
    {
      params: { blog: BLOG_BASE || undefined, page: undefined },
      props: { posts: await fetchPosts({ locale: 'da', fallbackLocale: 'en' }) },
    },
  ];
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { posts } = Astro.props as Props;

const metadata = {
  title: 'Skriverier',
  robots: {
    index: blogListRobots?.index,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'website',
  },
};
---

<Layout metadata={metadata} languageToggleHref={getPermalink('', 'blog')}>
  <section class="px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-6xl">
    <Headline>Skriverier</Headline>
    <p class="text-center text-lg text-muted dark:text-slate-400">
      Alle vores skriverier listet kronologisk. Se <a
        class="underline"
        href={getPermalink(`da/${CATEGORY_BASE}/briefs`)}>briefs</a
      > eller <a class="underline" href={getPermalink(`da/${CATEGORY_BASE}/essays`)}>essays</a>. Skriverier, der ikke er
      tilgængelige på dansk, vises på engelsk.
    </p>
    <Gallery {posts} locale="da" />
  </section>
</Layout>
