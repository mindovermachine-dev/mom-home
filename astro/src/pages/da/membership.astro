---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'MoM FOSS Alliance',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="For organisationer"
    title="Bliv en del af MoM FOSS Alliance"
    subtitle="Alliancemedlemskab samler organisationer, der vil støtte og præge udviklingen af Free Open Source Software i Mind over Machines laboratorium."
  />

  <section class="px-6 pt-12 sm:pt-16 mx-auto max-w-6xl">
    <div class="grid gap-8 md:grid-cols-[1.2fr_0.8fr]">
      <div>
        <h2 class="text-2xl md:text-3xl font-bold font-heading">En alliance med indflydelse</h2>
        <p class="mt-4 text-muted dark:text-slate-300">
          Alliancemedlemmer er organisationer, der støtter et socio-teknologisk fællesskab omkring regenerative metoder,
          teknikker og redskaber. Alliancemedlemskab er en betalt aftale med Mind over Machine, ikke et medlemskab af
          fonden. Indtægter fra alliancemedlemskaber og laboratorieydelser er øremærket udvikling, facilitering og drift
          af FOSS i laboratoriet.
        </p>
        <ul class="mt-6 grid gap-x-8 gap-y-3 text-muted dark:text-slate-300 sm:grid-cols-2">
          <li>
            Kvartalsvis invitation til MoM-FOSS Alliance, hvor laboratoriets retning og næste FOSS-indsats prioriteres
          </li>
          <li>Logo og profilbio i medlemsregistret på mindovermachine.dk og reference i offentlig kommunikation</li>
          <li>Deltagelse i Community of Practice på tværs af akademia, fagfolk og frivillige</li>
          <li>Mulighed for at være vært for CoP-events hos jer</li>
          <li>Alliancemedlemmer får 40% rabat på alle billetter til den årlige MoM-konference</li>
          <li>Mulighed for at slå opgaver og ledige stillinger op på medlemsplatformen</li>
        </ul>
      </div>
      <aside class="border-l-2 border-primary pl-6">
        <h2 class="text-xl font-bold font-heading">Medlemspriser</h2>
        <p class="mt-3 text-muted dark:text-slate-300">
          Alliancemedlemmer får klækkelige rabatter på ad hoc-timer, forudbetalte timepakker og løbende
          kapacitetsaftaler. Alliancemedlemskab forudsættes for Product Stewardship og løbende kapacitetsaftaler.
        </p>
        <a class="mt-4 inline-flex font-semibold hover:underline" href="/da/services/#priser"
          >Se ydelser og kapacitet <span aria-hidden="true">→</span></a
        >
      </aside>
    </div>
  </section>

  <section class="px-6 py-12 sm:py-16 mx-auto max-w-6xl border-t border-gray-200 dark:border-slate-700">
    <h2 class="text-2xl md:text-3xl font-bold font-heading">Vælg medlemsperiode</h2>
    <div class="mt-6 grid gap-8 sm:grid-cols-2">
      <article class="border-t-2 border-primary pt-5">
        <h3 class="text-lg font-semibold">Årligt medlemskab</h3>
        <p class="mt-2 text-3xl font-bold font-heading">
          10.000 kr. <span class="text-base font-normal text-muted">/ år</span>
        </p>
      </article>
      <article class="border-t-2 border-gray-300 pt-5 dark:border-slate-600">
        <h3 class="text-lg font-semibold">Månedligt medlemskab</h3>
        <p class="mt-2 text-3xl font-bold font-heading">
          1.000 kr. <span class="text-base font-normal text-muted">/ måned</span>
        </p>
      </article>
    </div>
    <p class="mt-4 text-sm text-muted dark:text-slate-300">Alle priser er ekskl. moms.</p>
  </section>

  <section class="px-6 py-12 sm:py-16 mx-auto max-w-6xl border-t border-gray-200 dark:border-slate-700" id="kapacitet">
    <div class="max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-bold font-heading">Løbende kapacitetsaftaler</h2>
      <p class="mt-3 text-muted dark:text-slate-300">
        En aftale om fast månedlig kapacitet sikrer løbende tilgængelighed til et FOSS-produkt eller internt initiativ.
        Aftalerne forudsætter alliancemedlemskab og kan tilpasses eller deles mellem flere alliancemedlemmer.
      </p>
      <p class="mt-3 text-muted dark:text-slate-300">
        Timeantal og priser nedenfor er eksempler, ikke faste pakker. Efter en analyse af jeres behov og projektets
        ambitionsniveau aftaler vi den kapacitet, der passer til opgaven. Aftalen kan derfor indeholde det antal timer,
        I har brug for.
      </p>
    </div>
    <div class="mt-8 grid gap-8 md:grid-cols-3">
      <article class="border-t-2 border-primary pt-5">
        <h3 class="text-xl font-bold">Maintainer</h3>
        <p class="mt-2 text-muted dark:text-slate-300">10 timer/måned</p>
        <p class="mt-1 text-2xl font-bold font-heading">9.600 kr./måned</p>
        <p class="mt-2 text-sm text-muted dark:text-slate-300">960 kr./time · 40% besparelse</p>
        <p class="mt-3 text-muted dark:text-slate-300">
          Eksempel: Stewardship, PR-reviews, release management og community-ledelse.
        </p>
      </article>
      <article class="border-t-2 border-primary pt-5">
        <h3 class="text-xl font-bold">Driver</h3>
        <p class="mt-2 text-muted dark:text-slate-300">25 timer/måned</p>
        <p class="mt-1 text-2xl font-bold font-heading">21.600 kr./måned</p>
        <p class="mt-2 text-sm text-muted dark:text-slate-300">864 kr./time · 46% besparelse</p>
        <p class="mt-3 text-muted dark:text-slate-300">
          Eksempel: Kodning, arkitektur, refaktorering, kvalitetssikring og koordinering.
        </p>
      </article>
      <article class="border-t-2 border-primary pt-5">
        <h3 class="text-xl font-bold">Core Driver</h3>
        <p class="mt-2 text-muted dark:text-slate-300">50 timer/måned</p>
        <p class="mt-1 text-2xl font-bold font-heading">40.800 kr./måned</p>
        <p class="mt-2 text-sm text-muted dark:text-slate-300">816 kr./time · 49% besparelse</p>
        <p class="mt-3 text-muted dark:text-slate-300">
          Eksempel: Dedikeret halvtidskapacitet til intensiv fremdrift på projektet.
        </p>
      </article>
    </div>
    <p class="mt-6 text-sm text-muted dark:text-slate-300">
      Besparelser er beregnet i forhold til standard ad hoc-timepris på 1.600 kr. Alle priser er ekskl. moms.
    </p>
  </section>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Tal om alliancemedlemskab',
        href: '/da/contact/',
      },
    ]}
    title="Overvejer I alliancemedlemskab for jeres organisation?"
    subtitle="Vi kan hjælpe jer med at vurdere, om alliancemedlemskab, stewardship eller en direkte serviceaftale er det rigtige match."
  />
</Layout>
