---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'MoM FOSS Alliance',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="For organizations"
    title="Join the MoM FOSS Alliance"
    subtitle="Alliance membership brings organizations together to support and shape Free Open Source Software in the Mind over Machine laboratory."
  />

  <section class="px-6 pt-12 sm:pt-16 mx-auto max-w-6xl">
    <div class="grid gap-8 md:grid-cols-[1.2fr_0.8fr]">
      <div>
        <h2 class="text-2xl md:text-3xl font-bold font-heading">An alliance with a say</h2>
        <p class="mt-4 text-muted dark:text-slate-300">
          Alliance members are organizations that support a socio-technical community exploring regenerative methods,
          tools and practices. Alliance membership is a paid agreement with Mind over Machine; it is not membership of
          the foundation. Alliance membership and laboratory service income is earmarked for developing, facilitating
          and operating FOSS in the laboratory.
        </p>
        <ul class="mt-6 grid gap-x-8 gap-y-3 text-muted dark:text-slate-300 sm:grid-cols-2">
          <li>
            Join quarterly MoM-FOSS Alliance sessions to help set priorities and shape the laboratory’s next FOSS
            initiatives
          </li>
          <li>Receive a member profile and logo on mindovermachine.dk, with a place in our public communications</li>
          <li>Take part in the Community of Practice, bringing together academia, professionals and volunteers</li>
          <li>Host Community of Practice events at your organization</li>
          <li>Get 40% off all tickets to the annual MoM conference</li>
          <li>Post project opportunities and open roles on the member platform</li>
        </ul>
      </div>
      <aside class="border-l-2 border-primary pl-6">
        <h2 class="text-xl font-bold font-heading">Member rates</h2>
        <p class="mt-3 text-muted dark:text-slate-300">
          Alliance members receive substantial discounts on ad-hoc work, prepaid hour bundles and ongoing capacity
          agreements. Alliance membership is required for Product Stewardship and ongoing capacity agreements.
        </p>
        <a class="mt-4 inline-flex font-semibold hover:underline" href="/services/#capacity">
          Explore services and capacity <span aria-hidden="true">→</span>
        </a>
      </aside>
    </div>
  </section>

  <section class="px-6 py-12 sm:py-16 mx-auto max-w-6xl border-t border-gray-200 dark:border-slate-700">
    <h2 class="text-2xl md:text-3xl font-bold font-heading">Choose your membership term</h2>
    <div class="mt-6 grid gap-8 sm:grid-cols-2">
      <article class="border-t-2 border-primary pt-5">
        <h3 class="text-lg font-semibold">Annual membership</h3>
        <p class="mt-2 text-3xl font-bold font-heading">
          DKK 10,000 <span class="text-base font-normal text-muted">/ year</span>
        </p>
      </article>
      <article class="border-t-2 border-gray-300 pt-5 dark:border-slate-600">
        <h3 class="text-lg font-semibold">Monthly membership</h3>
        <p class="mt-2 text-3xl font-bold font-heading">
          DKK 1,000 <span class="text-base font-normal text-muted">/ month</span>
        </p>
      </article>
    </div>
    <p class="mt-4 text-sm text-muted dark:text-slate-300">All prices exclude VAT.</p>
  </section>

  <section class="px-6 py-12 sm:py-16 mx-auto max-w-6xl border-t border-gray-200 dark:border-slate-700" id="capacity">
    <div class="max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-bold font-heading">Ongoing capacity agreements</h2>
      <p class="mt-3 text-muted dark:text-slate-300">
        An ongoing monthly agreement reserves capacity for a FOSS product or internal initiative. Alliance membership is
        required; agreements can be tailored or shared by several member organizations.
      </p>
      <p class="mt-3 text-muted dark:text-slate-300">
        The hours and prices below are examples, not fixed packages. After reviewing your needs and ambitions, we agree
        on the amount of capacity that fits the work. That can be any number of hours.
      </p>
    </div>
    <div class="mt-8 grid gap-8 md:grid-cols-3">
      <article class="border-t-2 border-primary pt-5">
        <h3 class="text-xl font-bold">Maintainer</h3>
        <p class="mt-2 text-muted dark:text-slate-300">Example: 10 hours/month</p>
        <p class="mt-1 text-2xl font-bold font-heading">DKK 9,600/month</p>
        <p class="mt-2 text-sm text-muted dark:text-slate-300">DKK 960/hour · 40% below the standard hourly rate</p>
        <p class="mt-3 text-muted dark:text-slate-300">
          Example work: stewardship, pull request reviews, releases and community coordination.
        </p>
      </article>
      <article class="border-t-2 border-primary pt-5">
        <h3 class="text-xl font-bold">Driver</h3>
        <p class="mt-2 text-muted dark:text-slate-300">Example: 25 hours/month</p>
        <p class="mt-1 text-2xl font-bold font-heading">DKK 21,600/month</p>
        <p class="mt-2 text-sm text-muted dark:text-slate-300">DKK 864/hour · 46% below the standard hourly rate</p>
        <p class="mt-3 text-muted dark:text-slate-300">
          Example work: coding, architecture, refactoring, quality and coordination.
        </p>
      </article>
      <article class="border-t-2 border-primary pt-5">
        <h3 class="text-xl font-bold">Core Driver</h3>
        <p class="mt-2 text-muted dark:text-slate-300">Example: 50 hours/month</p>
        <p class="mt-1 text-2xl font-bold font-heading">DKK 40,800/month</p>
        <p class="mt-2 text-sm text-muted dark:text-slate-300">DKK 816/hour · 49% below the standard hourly rate</p>
        <p class="mt-3 text-muted dark:text-slate-300">
          Example work: dedicated half-time capacity for intensive product progress.
        </p>
      </article>
    </div>
    <p class="mt-6 text-sm text-muted dark:text-slate-300">
      Discounts are compared with the standard ad-hoc rate of DKK 1,600/hour. All prices exclude VAT.
    </p>
  </section>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Talk about joining the Alliance',
        href: '/contact',
      },
    ]}
    title="Considering Alliance membership for your organization?"
    subtitle="Let’s work out whether Alliance membership, stewardship or a direct service agreement is the right starting point."
  />
</Layout>
