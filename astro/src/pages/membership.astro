---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Membership',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Membership"
    title="Membership for organizations building long-term software capability"
    subtitle="Membership combines strategic influence, community visibility, practical delivery support, and stewardship readiness in one relationship model."
  />

  <section class="px-6 sm:px-6 pt-12 sm:pt-16 lg:pt-20 mx-auto max-w-6xl">
    <div
      class="rounded-2xl border border-gray-200 bg-white p-6 md:p-8 shadow-sm dark:border-slate-700 dark:bg-slate-900"
    >
      <h2 class="text-2xl md:text-3xl font-bold font-heading">Benefits</h2>
      <p class="mt-4 text-muted dark:text-slate-300">
        Membership is the coordination model for how organizations influence the laboratory, access practical support,
        strengthen visibility, and collaborate across community, academia, and industry.
      </p>
      <div class="mt-6 grid gap-4 md:grid-cols-2 text-muted dark:text-slate-300">
        <ul class="space-y-3 list-disc pl-5">
          <li>Quarterly alliance participation with direct influence on priorities</li>
          <li>Preferred pricing on ad-hoc work, bundles, and retainers</li>
          <li>Community and academia exposure through events and collaboration</li>
        </ul>
        <ul class="space-y-3 list-disc pl-5">
          <li>Visibility via member profile, logo placement, and hosted events</li>
          <li>Recruitment channel for tasks and open roles</li>
          <li>Stewardship readiness for projects that need formal operating posture</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-6xl">
    <div class="grid gap-6 md:grid-cols-2">
      <article
        class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900"
      >
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-muted">Annual membership</p>
        <div class="mt-3 flex items-end gap-2">
          <span class="text-5xl font-bold font-heading">10,000</span>
          <span class="pb-1 text-muted">DKK / year excl. VAT</span>
        </div>
        <ul class="mt-6 space-y-3 text-muted">
          <li>Quarterly MoM-FOSS Alliance participation</li>
          <li>Public member profile and logo placement</li>
          <li>Access to event hosting and community visibility</li>
          <li>Membership pricing on extra hours and retainers</li>
        </ul>
      </article>

      <article
        class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900"
      >
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-muted">Monthly membership</p>
        <div class="mt-3 flex items-end gap-2">
          <span class="text-5xl font-bold font-heading">1,000</span>
          <span class="pb-1 text-muted">DKK / month excl. VAT</span>
        </div>
        <ul class="mt-6 space-y-3 text-muted">
          <li>Same stewardship participation and member benefits</li>
          <li>Flexible for organizations that want a lighter entry point</li>
          <li>Direct support for FOSS maintenance and development</li>
          <li>Can be combined with retainers for active projects</li>
        </ul>
      </article>
    </div>

    <div
      class="mt-8 rounded-2xl border border-gray-200 bg-white p-6 md:p-8 shadow-sm dark:border-slate-700 dark:bg-slate-900"
    >
      <h3 class="text-xl md:text-2xl font-bold font-heading">Pricing snapshot</h3>
      <p class="mt-2 text-muted dark:text-slate-300">
        Membership pricing is designed to make active stewardship work economically realistic once projects move from
        exploratory to sustained operation.
      </p>
      <div class="mt-6 grid gap-6 md:grid-cols-3 text-muted dark:text-slate-300">
        <div>
          <p class="text-sm uppercase tracking-[0.16em]">Ad-hoc hourly</p>
          <p class="mt-1 text-2xl font-bold font-heading">1,120 DKK</p>
          <p class="text-sm">vs. 1,600 DKK non-member</p>
        </div>
        <div>
          <p class="text-sm uppercase tracking-[0.16em]">Prepaid bundles</p>
          <p class="mt-1 text-2xl font-bold font-heading">up to 37% off</p>
          <p class="text-sm">on 30h and 50h bundles</p>
        </div>
        <div>
          <p class="text-sm uppercase tracking-[0.16em]">Retainers</p>
          <p class="mt-1 text-2xl font-bold font-heading">40-49% off</p>
          <p class="text-sm">based on monthly package size</p>
        </div>
      </div>
    </div>
  </section>

  <Features2
    title="Why organizations join"
    columns={2}
    items={[
      {
        title: 'Strategic direction and influence',
        description:
          'Membership includes participation in quarterly alliance sessions where member organizations help shape the next wave of laboratory focus and FOSS work.',
      },
      {
        title: 'Visibility and hosting opportunities',
        description:
          'Members are featured on the website and can host Community of Practice events with clear visibility to practitioners, researchers, and decision-makers.',
      },
      {
        title: 'Network and talent pipeline',
        description:
          'The model connects companies with academia, volunteers, and professionals, and creates a practical surface for recruitment through member-facing channels.',
      },
      {
        title: 'Conference and participation benefits',
        description:
          'Membership includes one full conference ticket and discounted access for additional participants, making it easier to involve broader teams.',
      },
      {
        title: 'Commercial leverage through member pricing',
        description:
          'Members get lower effective rates across ad-hoc delivery, prepaid bundles, and retainer models, which helps maintain momentum after strategy and pilots.',
      },
      {
        title: 'Stewardship when you need it',
        description:
          'For projects that need a stronger operating posture, membership provides a clear path into OSS stewardship transition and sustained quality governance.',
        callToAction: {
          variant: 'link',
          text: 'See OSS Stewardship Transition',
          href: '/services/oss-stewardship/',
        },
      },
      {
        title: 'Long-form management rationale',
        description:
          'For teams that need the full argumentation around governance, quality, CRA context, and alliance dynamics, we keep the deeper narrative as an essay.',
        callToAction: {
          variant: 'link',
          text: 'Read the essay',
          href: '/essays/why-oss-stewardship/',
        },
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Talk about membership',
        href: '/contact',
      },
    ]}
    title="Need membership for a project or an organization?"
    subtitle="We can help you decide whether membership, stewardship, or a direct service engagement is the right fit."
  />
</Layout>
