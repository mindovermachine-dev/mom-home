---
import { Icon } from 'astro-icon/components';

import MomImage from '~/components/common/MomImage.astro';
import PostTags from '~/components/blog/Tags.astro';
import ProfileAttribution from '~/components/profiles/ProfileAttribution.astro';
import SocialShare from '~/components/common/SocialShare.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';
import { fetchProfiles } from '~/utils/profiles';

import type { Post, ResolvedProfileReference } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
  locale?: 'en' | 'da';
}

const { post, url, locale = 'en' } = Astro.props;
const withLocalePrefix = (path: string) => {
  if (locale !== 'da') return path;
  return path === '/' ? '/da' : `/da${path}`;
};

const profileById = new Map((await fetchProfiles()).map((profile) => [profile.id, profile]));
const toResolvedProfileReference = (id: string): ResolvedProfileReference => ({ id, profile: profileById.get(id) });

const authorEntries = post.author ? [toResolvedProfileReference(post.author)] : [];
const coauthorEntries = post.coauthor ? [toResolvedProfileReference(post.coauthor)] : [];
const reviewerEntries = post.reviewers?.map(toResolvedProfileReference) || [];

const debateLinks = [
  post.debate?.mastodon && { href: post.debate.mastodon, label: 'Mastodon', icon: 'tabler:brand-mastodon' },
  post.debate?.linkedin && { href: post.debate.linkedin, label: 'LinkedIn', icon: 'tabler:brand-linkedin' },
  post.debate?.bluesky && { href: post.debate.bluesky, label: 'Bluesky', icon: 'tabler:brand-bluesky' },
].filter((link): link is { href: string; label: string; icon: string } => Boolean(link));
---

<section class="py-8 sm:py-16 lg:py-20 mx-auto">
  <article>
    <header
      class={post.image
        ? 'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
        : 'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'}
    >
      <div class="flex justify-between flex-col sm:flex-row max-w-3xl mx-auto mt-0 mb-2 px-4 sm:px-6 sm:items-center">
        <p>
          <Icon name="tabler:clock" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
          <time datetime={String(post.publishDate)} class="inline-block">{getFormattedDate(post.publishDate)}</time>
          {
            (authorEntries.length || coauthorEntries.length || reviewerEntries.length) && (
              <>
                {' '}
                · <Icon name="tabler:user" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
                {authorEntries.length > 0 && <ProfileAttribution label="Author" entries={authorEntries} />}
                {coauthorEntries.length > 0 && (
                  <>
                    {' '}
                    · <ProfileAttribution label="Coauthor" entries={coauthorEntries} />
                  </>
                )}
                {reviewerEntries.length > 0 && (
                  <>
                    {' '}
                    · <ProfileAttribution label="Reviewers" entries={reviewerEntries} />
                  </>
                )}
              </>
            )
          }
          {
            post.category && (
              <>
                {' '}
                ·{' '}
                <a
                  class="hover:underline inline-block"
                  href={withLocalePrefix(getPermalink(post.category.slug, 'category'))}
                >
                  {post.category.title}
                </a>
              </>
            )
          }
          {
            post.readingTime && (
              <>
                &nbsp;· <span>{post.readingTime}</span> min read
              </>
            )
          }
        </p>
      </div>

      {
        debateLinks.length > 0 && (
          <p class="max-w-3xl mx-auto mb-2 px-4 sm:px-6 text-sm text-muted dark:text-slate-400">
            Join the debate on{' '}
            {debateLinks.map((link, index) => (
              <>
                {index > 0 && ' · '}
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:underline inline-flex items-center gap-1"
                >
                  <Icon name={link.icon} class="w-4 h-4 inline-block -mt-0.5" />
                  {link.label}
                </a>
              </>
            ))}
          </p>
        )
      }

      <h1
        class="px-4 sm:px-6 max-w-3xl mx-auto text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading"
      >
        {post.title}
      </h1>
      <p
        class="max-w-3xl mx-auto mt-4 mb-8 px-4 sm:px-6 text-xl md:text-2xl text-muted dark:text-slate-400 text-justify"
      >
        {post.excerpt}
      </p>

      {
        post.image ? (
          <MomImage
            src={post.image}
            alt={post?.excerpt || ''}
            caption={post.imageText}
            size="full"
            class="max-w-full lg:max-w-[900px] mb-6"
            imageClass="bg-gray-400 dark:bg-slate-700"
            loading="eager"
            decoding="async"
          />
        ) : (
          <div class="max-w-3xl mx-auto px-4 sm:px-6">
            <div class="border-t dark:border-slate-700" />
          </div>
        )
      }
    </header>
    <div
      class="mx-auto px-6 sm:px-6 max-w-3xl prose prose-md lg:prose-xl dark:prose-invert dark:prose-headings:text-slate-300 prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg mt-8 prose-headings:scroll-mt-[80px] prose-li:my-0"
    >
      <slot />
    </div>
    <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-8 flex justify-between flex-col sm:flex-row">
      <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" locale={locale} />
      <SocialShare url={url} text={post.title} class="mt-5 sm:mt-1 align-middle text-gray-500 dark:text-slate-600" />
    </div>
  </article>
</section>
