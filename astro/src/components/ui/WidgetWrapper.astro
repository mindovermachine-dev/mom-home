---
import type { HTMLTag } from 'astro/types';
import type { Widget } from '~/types';
import { twMerge } from 'tailwind-merge';
import { UI } from 'astrowind:config';

export interface Props extends Widget {
  containerClass?: string;
  spacing?: 'normal' | 'compact';
  ['as']?: HTMLTag;
}

const { id, isDark = false, containerClass = '', spacing = UI.widgetWrapper.spacing, bg, as = 'section' } = Astro.props;

const WrapperTag = as;
---

<WrapperTag class="relative not-prose scroll-mt-[72px]" {...id ? { id } : {}}>
  <div class="absolute inset-0 pointer-events-none -z-[1]" aria-hidden="true">
    <slot name="bg">
      {
        bg ? (
          <Fragment set:html={bg} />
        ) : (
          <div class:list={['absolute inset-0', { 'bg-dark dark:bg-transparent': isDark }]} />
        )
      }
    </slot>
  </div>
  <div
    class:list={[
      twMerge(
        `relative mx-auto max-w-7xl px-4 md:px-6 text-default intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade ${
          spacing === 'compact' ? 'py-6 md:py-8 lg:py-10' : 'py-12 md:py-16 lg:py-20'
        }`,
        containerClass
      ),
      { dark: isDark },
    ]}
  >
    <slot />
  </div>
</WrapperTag>
