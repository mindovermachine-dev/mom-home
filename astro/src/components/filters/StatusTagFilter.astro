---
export interface Option {
  value: string;
  label: string;
}

export interface Props {
  listId: string;
  itemSelector: string;
  statusOptions: Option[];
  tagOptions: Option[];
  statusParam?: string;
  tagsParam?: string;
  statusLabel?: string;
  tagsLegend?: string;
  clearLabel?: string;
  summaryLabel?: string;
}

const {
  listId,
  itemSelector,
  statusOptions,
  tagOptions,
  statusParam = 'status',
  tagsParam = 'tags',
  statusLabel = 'Status',
  tagsLegend = 'Tags',
  clearLabel = 'Clear filters',
  summaryLabel = 'Filter results',
} = Astro.props;
---

<section
  class="mt-8 rounded-xl border-[3px] border-[#1C4331] p-4"
  data-status-tag-filter
  data-list-id={listId}
  data-item-selector={itemSelector}
  data-status-options={statusOptions.map((option) => option.value).join(',')}
  data-status-param={statusParam}
  data-tags-param={tagsParam}
  data-summary-label={summaryLabel}
>
  <div class="grid gap-4 md:grid-cols-[minmax(0,220px)_1fr_auto] md:items-start">
    <label class="text-sm font-medium" for={`${listId}-status`}>
      {statusLabel}
      <select
        id={`${listId}-status`}
        class="mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-900"
        data-filter-status
      >
        <option value="">All</option>
        {statusOptions.map((option) => <option value={option.value}>{option.label}</option>)}
      </select>
    </label>

    <fieldset class="min-w-0">
      <legend class="text-sm font-medium">{tagsLegend}</legend>
      <div class="mt-2 flex flex-wrap gap-2">
        {
          tagOptions.map((option) => (
            <label class="inline-flex items-center gap-2 rounded-md border border-gray-300 px-2 py-1 text-sm dark:border-slate-600">
              <input type="checkbox" value={option.value} data-filter-tag />
              <span>{option.label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <button
      type="button"
      class="inline-flex self-start justify-center rounded-md border border-gray-300 px-3 py-2 text-sm font-medium hover:bg-gray-50 dark:border-slate-600 dark:hover:bg-slate-800"
      data-filter-clear
    >
      {clearLabel}
    </button>
  </div>

  <p class="mt-3 text-sm text-muted dark:text-slate-400" aria-live="polite" data-filter-summary>
    {summaryLabel}
  </p>
</section>

<script>
  import { parseCsvParamValues, parseSingleEnumParam, withUpdatedFilterSearchParams } from '~/utils/query-state';

  type FilterState = { status?: string; tags: string[] };

  document.querySelectorAll('[data-status-tag-filter]').forEach((filterRoot) => {
    const listId = filterRoot.getAttribute('data-list-id') ?? '';
    const itemSelector = filterRoot.getAttribute('data-item-selector') ?? 'li[data-filter-item]';
    const statusParam = filterRoot.getAttribute('data-status-param') ?? 'status';
    const tagsParam = filterRoot.getAttribute('data-tags-param') ?? 'tags';
    const summaryLabel = filterRoot.getAttribute('data-summary-label') ?? 'Filter results';
    const statusValues = new Set(
      (filterRoot.getAttribute('data-status-options') ?? '')
        .split(',')
        .map((value) => value.trim())
        .filter(Boolean)
    );
    const list = document.getElementById(listId);
    if (!list) return;

    const statusSelect = filterRoot.querySelector('[data-filter-status]');
    const tagInputs = Array.from(filterRoot.querySelectorAll('[data-filter-tag]'));
    const clearButton = filterRoot.querySelector('[data-filter-clear]');
    const summary = filterRoot.querySelector('[data-filter-summary]');
    const items = Array.from(list.querySelectorAll(itemSelector));

    const readStateFromUrl = () => {
      const params = new URLSearchParams(window.location.search);
      const status = parseSingleEnumParam(params.getAll(statusParam), statusValues);
      const tags = parseCsvParamValues(params.getAll(tagsParam));

      return { status, tags };
    };

    const applyState = (state: FilterState, updateUrl: boolean) => {
      const tagSet = new Set(state.tags);
      let visibleItems = 0;

      items.forEach((item) => {
        const itemStatus = String(item.getAttribute('data-filter-status') ?? '').toLowerCase();
        const itemTags = String(item.getAttribute('data-filter-tags') ?? '')
          .split(',')
          .map((tag) => tag.trim().toLowerCase())
          .filter(Boolean);
        const statusMatch = !state.status || itemStatus === state.status;
        const tagsMatch = state.tags.length === 0 || itemTags.some((tag) => tagSet.has(tag));
        const isVisible = statusMatch && tagsMatch;

        item.toggleAttribute('hidden', !isVisible);
        item.setAttribute('aria-hidden', isVisible ? 'false' : 'true');
        if (isVisible) visibleItems += 1;
      });

      if (summary) {
        summary.textContent = `${summaryLabel}: ${visibleItems} of ${items.length}`;
      }

      if (statusSelect instanceof HTMLSelectElement) {
        statusSelect.value = state.status ?? '';
      }

      tagInputs.forEach((input) => {
        if (input instanceof HTMLInputElement) {
          input.checked = tagSet.has(input.value.toLowerCase());
        }
      });

      if (updateUrl) {
        const updatedParams = withUpdatedFilterSearchParams({
          existing: new URLSearchParams(window.location.search),
          managedKeys: [statusParam, tagsParam],
          next: {
            [statusParam]: state.status,
            [tagsParam]: state.tags.length > 0 ? state.tags.join(',') : undefined,
          },
        });
        const nextQuery = updatedParams.toString();
        const nextUrl = nextQuery ? `${window.location.pathname}?${nextQuery}` : window.location.pathname;
        window.history.replaceState({}, '', nextUrl);
      }
    };

    const readStateFromControls = () => ({
      status:
        statusSelect instanceof HTMLSelectElement && statusValues.has(statusSelect.value)
          ? statusSelect.value
          : undefined,
      tags: tagInputs
        .filter((input) => input instanceof HTMLInputElement && input.checked)
        .map((input) => (input instanceof HTMLInputElement ? input.value.toLowerCase() : ''))
        .filter(Boolean),
    });

    statusSelect?.addEventListener('change', () => applyState(readStateFromControls(), true));
    tagInputs.forEach((input) => input.addEventListener('change', () => applyState(readStateFromControls(), true)));
    clearButton?.addEventListener('click', () => applyState({ status: undefined, tags: [] }, true));

    applyState(readStateFromUrl(), false);
  });
</script>
