---
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import Image from '~/components/common/Image.astro';
import { getExternalLinkAttrs } from '~/utils/external-links';
import { findImage } from '~/utils/images';

type Position = 'left' | 'center' | 'right';
type WidthPreset = 'tiny' | 'small' | 'medium' | 'large' | 'full';
type Mode = 'static' | 'flow';

export interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'width' | 'height' | 'class'> {
  src: string | ImageMetadata;
  alt: string;
  caption?: string;
  position?: Position;
  width?: string;
  height?: string;
  mode?: Mode;
  url?: string;
  class?: string;
  imageClass?: string;
  captionClass?: string;
}

const {
  src,
  alt,
  caption,
  position = 'center',
  width,
  height,
  mode = 'static',
  url,
  class: figureClass,
  imageClass,
  captionClass,
  ...rest
} = Astro.props;

if ('size' in Astro.props) {
  throw new Error('MomImage: `size` has been removed; use `width` for presets or `height` for a CSS height.');
}

const sizeConfig: Record<WidthPreset, { width: number; widths: number[]; sizes: string }> = {
  tiny: {
    width: 320,
    widths: [240, 320, 480],
    sizes: '(max-width: 320px) 100vw, 320px',
  },
  small: {
    width: 480,
    widths: [320, 480, 768],
    sizes: '(max-width: 480px) 100vw, 480px',
  },
  medium: {
    width: 640,
    widths: [480, 640, 768],
    sizes: '(max-width: 640px) 100vw, 640px',
  },
  large: {
    width: 768,
    widths: [480, 768, 1000],
    sizes: '(max-width: 768px) 100vw, 768px',
  },
  full: {
    width: 1600,
    widths: [768, 1200, 1600, 2000],
    sizes: '100vw',
  },
};

const isPreset = (value: string): value is WidthPreset => Object.hasOwn(sizeConfig, value);
const isLength = (value: string) => /^(?:\d+(?:\.\d+)?|\.\d+)(?:px|vh|vw)$/.test(value);
if (width !== undefined && !isPreset(width) && !isLength(width)) {
  throw new Error(`MomImage: invalid width "${width}"; use a preset or a CSS length in px, vh, or vw.`);
}
if (height !== undefined && !isLength(height)) {
  throw new Error(`MomImage: invalid height "${height}"; use a CSS length in px, vh, or vw.`);
}

const preset = width && isPreset(width) ? width : width || height ? undefined : 'large';
const imgConfig = sizeConfig[preset ?? 'large'];
const resolved = await findImage(src);
const sourceWidth = resolved && typeof resolved === 'object' && 'width' in resolved ? resolved.width : undefined;
const contentWidth =
  sourceWidth && imgConfig.width ? Math.min(sourceWidth, imgConfig.width) : (sourceWidth ?? imgConfig.width);
const customDimensions = !preset || height !== undefined;
const contentStyle =
  !customDimensions && contentWidth ? `--mom-image-content-width:min(100%, ${contentWidth}px)` : undefined;
const figureStyle = customDimensions
  ? `width:${preset ? `min(100%, ${imgConfig.width}px)` : width ? `min(100%, ${width})` : 'fit-content'};max-width:100%`
  : undefined;
const imageStyle = customDimensions
  ? `width:${width ? '100%' : 'auto'};height:${height ?? 'auto'};max-width:100%;object-fit:contain${rest.style ? `;${rest.style}` : ''}`
  : rest.style;
---

<figure
  class:list={[
    'mom-image',
    `mom-image--${mode}`,
    `mom-image--position-${position}`,
    preset && `mom-image--size-${preset}`,
    figureClass,
  ]}
  style={figureStyle}
>
  <div class="mom-image__content" style={contentStyle}>
    {
      url ? (
        <a href={url} {...getExternalLinkAttrs(url)}>
          <Image
            src={src}
            alt={alt}
            width={imgConfig.width}
            widths={imgConfig.widths}
            sizes={imgConfig.sizes}
            layout={customDimensions ? 'responsive' : 'constrained'}
            class:list={['mom-image__img', imageClass]}
            {...rest}
            style={imageStyle}
          />
        </a>
      ) : (
        <Image
          src={src}
          alt={alt}
          width={imgConfig.width}
          widths={imgConfig.widths}
          sizes={imgConfig.sizes}
          layout={customDimensions ? 'responsive' : 'constrained'}
          class:list={['mom-image__img', imageClass]}
          {...rest}
          style={imageStyle}
        />
      )
    }
    {caption && <figcaption class:list={['mom-image-caption', captionClass]}>{caption}</figcaption>}
  </div>
</figure>
